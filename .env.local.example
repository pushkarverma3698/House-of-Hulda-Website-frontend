# Copy to `.env.local` and fill. None of these are required for the site to RUN —
# WhatsApp enquiry works with zero backend. They enable email capture + analytics.

# --- Analytics (set in Vercel → Project → Settings → Environment Variables) ---
# GA4 measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=
# Meta (Facebook) Pixel ID, e.g. 1234567890
NEXT_PUBLIC_META_PIXEL_ID=

# --- Enquiry email (optional; WhatsApp is the guaranteed channel) ---
# Resend API key — sign up at resend.com, verify your domain, paste the key.
RESEND_API_KEY=
# From address Resend sends as (must be a verified domain or onboarding@resend.dev)
ENQUIRY_FROM="House of Hulda <hello@houseofhuldamanali.com>"
